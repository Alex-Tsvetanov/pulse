# ---------------------------------------------------------------------------
# LaTeX (docs/)
# ---------------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# latexmk пише в docs/build/. Игнорира се цялата, с изключение на готовия PDF:
# той е крайният резултат и се предава, затова се версионира заедно с източника си.
# (git не поддържа коментар след шаблон на същия ред, затова редовете са отделни)
docs/build/*
!docs/build/Main.pdf

# Генерирани от инструмента за измервания макроси и таблици. Двата заместващи файла
# се версионират: preamble.tex прави \input към тях и без тях компилацията спира.
docs/generated/*
!docs/generated/board_macros.tex
!docs/generated/gif_frames.tex

